<project cnversion="1">
    <name>test_project</name>
    <version>1.0.0</version>

    <builds>
        <binary os="linux" arch="amd64">
            <dependencies>
                <module>core</module>
                <module>assets</module>
                <module>graphic</module>
                <module>audio</module>
                <module>network</module>
            </dependencies>
            <name>${project_name}-client-windows-64bits</name>
            <entry>
                main
            </entry>
        </binary>
    </builds>

    <ressources>
        <dir type="objects">${project_root}/objects</dir>
        <dir type="scenes">${project_root}/scenes</dir>
        <dir type="assets">${project_root}/assets</dir>
        <dir type="guis">${project_root}/guis</dir>
        <file type="srcs">${project_root}/src/block.c</file>
    </ressources>
</project>
