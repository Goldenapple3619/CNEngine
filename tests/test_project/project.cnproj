<project cnversion="1">
    <name>test_project</name>
    <version>1.0.0</version>

    <builds>
        <binary type="client" os="win" arch="amd64">
            <dependencies>
                <module>core</module>
                <module>graphic</module>
                <module>audio</module>
                <module>network</module>
            </dependencies>
            <name>${project_name}-client-windows-64bits.exe</name>
            <entry>
                main
            </entry>
        </binary>
        <binary type="server" os="win" arch="amd64">
            <dependencies>
                <module>core</module>
                <module>graphic-headless</module>
                <module>audio</module>
                <module>network</module>
            </dependencies>
            <name>${project_name}-server-windows-64bits.exe</name>
            <entry>
                main
            </entry>
        </binary>
    </builds>

    <ressources>
        <path type="objects">${project_root}/objects</path>
        <path type="scenes">${project_root}/scenes</path>
    </ressources>
</project>
